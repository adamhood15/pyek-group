    </div>
    <table border="0" cellpadding="0" cellspacing="0" width="100%" role="presentation">
      <tbody>
        <tr>
          <td align="center" bgcolor="ffffff">
            <table class="container" border="0" cellpadding="0" cellspacing="0" width="100%" style="min-width: 600px" role="presentation">
              <tbody>
                <tr>
                  <td>
                    <table width="100%" border="0" align="center" cellpadding="0" cellspacing="0" role="presentation">
                      <tbody>
                        <tr>
                          <td align="center" bgcolor="ffffff">
                            <table width="600" border="0" align="center" cellpadding="0" cellspacing="0" style="width: 600px; border: none !important" role="presentation">
                              <tbody>
                                <tr>
                                  <td>
                                    <!-- Body -->
                                    <table width="600" border="0" align="center" cellpadding="0" cellspacing="0" style="width: 600px" role="presentation" bgcolor="{{theme.backgroundColor}}">
                                      <!-- Body -->

                                      {{#each sections}}
                                        {{#if (eq this.type "heading")}}
                                          {{> heading}}
                                        {{/if}}

                                        {{#if (eq this.type "image")}}
                                          {{> image}}
                                        {{/if}}

                                        {{#if (eq this.type "single-column")}}
                                          {{> single-column}}
                                        {{/if}}

                                        {{#if (eq this.type "two-column")}}
                                          {{> two-column}}
                                        {{/if}}

                                        {{#if (eq this.type "three-column")}}
                                          {{> three-column}}
                                        {{/if}}

                                        {{#if (eq this.type "cta-button")}}
                                          {{> cta-button}}
                                        {{/if}}

                                        {{#if (eq this.type "cta-dual")}}
                                          {{> cta-dual}}
                                        {{/if}}

                                        {{#if (eq this.type "spacer")}}
                                          {{> spacer}}
                                        {{/if}}

                                        {{#if (eq this.type "divider")}}
                                          {{> divider}}
                                        {{/if}}
                                      {{/each}}

                                    </table>
                                  </td>
                                </tr>
                                {{> footer}}
                              </tbody>
                            </table>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</body>

</html>
