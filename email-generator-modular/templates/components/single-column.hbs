<!-- Single Column Text Component -->
<tr>
  <td style="
    font: {{#if this.fontWeight}}{{this.fontWeight}}{{else}}400{{/if}} {{#if this.fontSize}}{{this.fontSize}}{{else}}24px{{/if}}/{{#if this.lineHeight}}{{this.lineHeight}}{{else}}34px{{/if}} 'aloevera display', Arial, sans-serif;
    text-align: {{#if this.textAlign}}{{this.textAlign}}{{else}}center{{/if}};
    padding: {{#if this.padding}}{{this.padding}}{{else}}35px 0{{/if}};
    color: {{#if this.color}}{{this.color}}{{else}}{{@root.theme.textColor}}{{/if}};
    background-color: {{@root.theme.backgroundColor}};
  " class="dark-mode">
    {{{this.content}}}
  </td>
</tr>
