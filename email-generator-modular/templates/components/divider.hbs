<!-- Divider Component -->
<tr>
  <td style="padding: {{#if this.padding}}{{this.padding}}{{else}}20px 0{{/if}}; background-color: {{@root.theme.backgroundColor}};" class="dark-mode">
    <table width="100%" border="0" cellspacing="0" cellpadding="0" role="presentation">
      <tr>
        <td style="border-top: {{#if this.thickness}}{{this.thickness}}{{else}}1px{{/if}} {{#if this.style}}{{this.style}}{{else}}solid{{/if}} {{#if this.color}}{{this.color}}{{else}}#cccccc{{/if}}; line-height: 0; font-size: 0;">
          &nbsp;
        </td>
      </tr>
    </table>
  </td>
</tr>
